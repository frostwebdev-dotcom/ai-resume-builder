# -----------------------------------------------------------------------------
# Smart Resume Builder — copy to `.env.local` for local development
# -----------------------------------------------------------------------------

# Public site URL (used in emails, Stripe redirects, auth `redirectTo`; must match how you open the app in dev).
# Supabase Auth → Redirect URLs: `${NEXT_PUBLIC_APP_URL}/auth/callback` (e.g. http://localhost:3000/auth/callback).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Marketing contact email (mailto on /contact)
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Supabase (Postgres, Auth, Storage) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side (optional if mirroring public URL/key; service role for admin jobs only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
# Chat completions model (resume AI + guest “Upload existing resume” import); defaults to gpt-4o if unset
OPENAI_MODEL=gpt-4o

# --- Resend (transactional email) --------------------------------------------
RESEND_API_KEY=
# Verified sender in Resend, e.g. "Smart Resume Builder <noreply@yourdomain.com>"
EMAIL_FROM=
# Optional reply-to on transactional messages
EMAIL_REPLY_TO=
# Optional: staff inbox for copies of /contact form submissions
CONTACT_FORM_NOTIFY_EMAIL=

# --- Upstash Redis (rate limiting) -------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Sentry ------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
# Optional: source maps upload in CI
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
